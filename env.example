# Copy to .env and fill values

# MySQL
# DATABASE_URL="mysql://user:password@localhost:3306/spms"
# PostgreSQL (Vercel / Neon / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/spms?sslmode=require"
# DIRECT_URL is needed for migrations if using connection pooling (Vercel Postgres)
DIRECT_URL="postgresql://user:password@localhost:5432/spms?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-with-openssl-rand-base64-32"

# File storage: local uploads dir (or configure Cloudinary vars if using)
UPLOAD_DIR="public/uploads"
